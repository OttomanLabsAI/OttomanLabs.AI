# Cloudflare Pages — headers config
# Docs: https://developers.cloudflare.com/pages/configuration/headers/

# Downloadable files: force a "Save As" dialog rather than opening in-tab.
/assets/Fadil-Karim-CV.pdf
  Content-Disposition: attachment; filename="Fadil-Karim-CV.pdf"

# When you add downloadable model files, uncomment / extend these:
# /assets/*.gh
#   Content-Disposition: attachment
# /assets/*.rfa
#   Content-Disposition: attachment
# /assets/*.zip
#   Content-Disposition: attachment

# Long-cache the static assets (fonts, images, the PDF) — they rarely change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The stylesheet changes with the site — revalidate like the HTML does.
# Kept AFTER the /assets/* rule so this Cache-Control wins over "immutable".
/assets/styles.css
  Cache-Control: public, max-age=0, must-revalidate

# pyGherkin pyRevit extension — force download and revalidate so updates ship.
# Kept AFTER the /assets/* rule so this Cache-Control wins over "immutable".
/assets/pyGherkin.extension.zip
  Content-Disposition: attachment; filename="pyGherkin.extension.zip"
  Cache-Control: public, max-age=0, must-revalidate

/assets/pyDymak.extension.zip
  Content-Disposition: attachment; filename="pyDymak.extension.zip"
  Cache-Control: public, max-age=0, must-revalidate

# Cloud-save scripts: revalidate so config/logic changes ship on redeploy.
# Kept AFTER the /assets/* rule so this Cache-Control wins over "immutable".
/assets/firebase-config.js
  Cache-Control: public, max-age=0, must-revalidate
/assets/ol-cloud.js
  Cache-Control: public, max-age=0, must-revalidate
/assets/ol-export3d.js
  Cache-Control: public, max-age=0, must-revalidate

# HTML pages: always revalidate so edits show up immediately on redeploy.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Sensible security headers for a static site.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
